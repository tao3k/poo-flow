# Gerbil package dependency revisions are generated from gerbil.pkg by
# `just pin-gerbil-dependency`. Core is compiled directly from the Git
# submodule, so it has no external source-package projection here.

gerbil_dependency_sources = use_extension(
    "@gerbil_bazel//gerbil:extensions.bzl",
    "gerbil",
)
gerbil_dependency_sources.source_package(
    name = "gerbil_poo_sources",
    canonical_uri = "https://github.com/tao3k/gerbil-poo",
    package = "gerbil-poo",
    revision = "099b381588360a8a49fd772f666a1a00351366f5",
    sha256 = "5cafed5170c4ade18a1cce3898149f92b236aabba11c80020359f19531084597",
    strip_prefix = "gerbil-poo-099b381588360a8a49fd772f666a1a00351366f5",
    urls = [
        "https://github.com/tao3k/gerbil-poo/archive/099b381588360a8a49fd772f666a1a00351366f5.tar.gz",
    ],
)
gerbil_dependency_sources.source_package(
    name = "asp_gerbil_scheme_sources",
