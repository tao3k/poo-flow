# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv
.ci/

# pre-commit
.pre-commit-config.yaml
.data
# Gerbil std/make output for the poo-flow executable.
.bin
.gerbil
manifest.ss
version.ss

# Bazel convenience symlinks and output trees.
/bazel-*

# Shared native binding build cache.
/target/

# Local Python packaging and native-extension build outputs.
__pycache__/
*.py[cod]
*.egg-info/
*.so

# Generated runtime-WASM bundle artifacts are build outputs, not sources.
/bindings/runtime-wasm/workflows/*.bin
/bindings/runtime-wasm/workflows/.human-capability.*.tmp
/bindings/runtime-wasm/workflows/*.backup
/bindings/runtime-wasm/workflows/.human-capability.publication.json*
