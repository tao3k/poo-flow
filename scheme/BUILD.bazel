load(
    "@gerbil_bazel//gerbil:defs.bzl",
    "gerbil_project_compile",
    "gerbil_project_dev",
    "gerbil_project_test",
)
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bazel:gerbil_project_environment.bzl", "gerbil_project_environment")
load(
    "//tools/bazel:gerbil_projection.bzl",
    "gerbil_project_contract_projection",
    "gerbil_project_projection",
)
load("//tools/bazel:gerbil_receipt.bzl", "gerbil_project_receipt_v1_test")

package(default_visibility = ["//visibility:public"])

gerbil_project_compile(
    name = "gerbil_utils_package",
    srcs = ["@gerbil_utils_sources//:sources"],
    build_script = "@gerbil_utils_sources//:build_script",
    process_guard = True,
    require_library_output = True,
    source_resolution_receipts = [
        "@gerbil_utils_sources//:source_resolution_receipt",
    ],
)

gerbil_project_compile(
    name = "gerbil_poo_package",
    srcs = ["@gerbil_poo_sources//:sources"],
    build_script = "@gerbil_poo_sources//:build_script",
    process_guard = True,
    require_library_output = True,
    source_resolution_receipts = [
        "@gerbil_poo_sources//:source_resolution_receipt",
    ],
    deps = [":gerbil_utils_package"],
)

gerbil_project_compile(
    name = "gslph_package",
    srcs = ["@gslph_sources//:sources"],
    build_script = "@gslph_sources//:build_script",
    process_guard = True,
    require_library_output = True,
    source_resolution_receipts = [
        "@gslph_sources//:source_resolution_receipt",
    ],
    deps = [":gerbil_poo_package"],
)

filegroup(
    name = "dependency_packages",
    srcs = [
        ":gerbil_poo_package",
        ":gerbil_utils_package",
        ":gslph_package",
    ],
)

[
    filegroup(
        name = name,
        srcs = [project],
        output_group = "project_root",
    )
    for name, project in [
        ("gerbil_utils_package_project_root", ":gerbil_utils_package"),
        ("gerbil_poo_package_project_root", ":gerbil_poo_package"),
        ("gslph_package_project_root", ":gslph_package"),
    ]
]

gerbil_project_compile(
    name = "dependency_source_contract_compile",
    srcs = ["//:dependency_source_contract_sources"],
    build_script = "//:dependency_source_contract_build_script",
    process_guard = True,
    receipt_line_prefix = "POO_FLOW_DEPENDENCY_SOURCE_CONTRACT_BUILD_RECEIPT ",
    require_library_output = True,
    deps = [":gerbil_poo_package"],
)

gerbil_project_contract_projection(
    name = "dependency_source_contract_projection",
    output_name = "poo-flow-dependency-source-contract.json",
    project = ":dependency_source_contract_compile",
    projector = ":write_dependency_source_contract_projection.ss",
)

gerbil_project_test(
    name = "dependency_source_contract_test",
    size = "small",
    srcs = "//:dependency_source_contract_test_sources",
    project = ":dependency_source_contract_compile",
    source_root_marker = "//:scheme_source_root_marker",
    tests = ["//:t/dependency-source-identity-test.ss"],
)

gerbil_project_compile(
    name = "runtime_wasm_generator_compile",
    srcs = ["//:runtime_wasm_generator_scheme_sources"],
    args = ["compile"],
    build_script = "//:runtime_wasm_generator_build_script",
    process_guard = True,
    require_library_output = True,
    receipt_line_prefix = "POO_FLOW_RUNTIME_WASM_GENERATOR_BUILD_RECEIPT ",
    deps = [":gerbil_poo_package"],
)

gerbil_project_compile(
    name = "compile_performance_budget_package",
    srcs = ["//:compile_performance_budget_sources"],
    args = ["compile"],
    build_script = "//:compile_performance_budget_build_script",
    process_guard = True,
    require_library_output = True,
    deps = [":gerbil_poo_package"],
)

filegroup(
    name = "compile_performance_budget_package_project_root",
    srcs = [":compile_performance_budget_package"],
    output_group = "project_root",
)

gerbil_project_test(
    name = "compile_performance_budget_unit_test",
    size = "small",
    srcs = "//:compile_performance_budget_test_sources",
    project = ":compile_performance_budget_package",
    source_root_marker = "//:scheme_source_root_marker",
    tests = ["//:t/build-api-project-compile-performance-budget-test.ss"],
)

filegroup(
    name = "runtime_wasm_generator_compile_receipt",
    srcs = [":runtime_wasm_generator_compile"],
    output_group = "receipt",
)

gerbil_project_receipt_v1_test(
    name = "runtime_wasm_generator_compile_receipt_v1_test",
    receipt = ":runtime_wasm_generator_compile_receipt",
    size = "small",
)

gerbil_project_dev(
    name = "runtime_wasm_generator_dev_compile",
    args = ["compile"],
    build_script = "//:runtime_wasm_generator_build_script",
    deps = [":runtime_wasm_generator_compile"],
    tags = ["local", "manual"],
)

sh_binary(
    name = "runtime_wasm_generator_materialize",
    srcs = ["materialize_gerbil_projects.sh"],
    args = [
        "$(locations :gerbil_utils_package)",
        "$(locations :gerbil_poo_package)",
        "$(locations :runtime_wasm_generator_compile)",
    ],
    data = [
        ":gerbil_utils_package",
        ":gerbil_poo_package",
        ":runtime_wasm_generator_compile",
        "@bazel_tools//tools/bash/runfiles",
    ],
    tags = ["local", "manual"],
)

gerbil_project_compile(
    name = "compile",
    srcs = ["//:scheme_build_sources"],
    args = ["compile"],
    build_script = "//:build.ss",
    receipt_line_prefix = "POO_FLOW_PROJECT_BUILD_RECEIPT ",
    deps = [":gslph_package"],
)

gerbil_project_environment(
    name = "python_runtime_test_environment",
    project = ":compile",
    working_directory = "packages/python-runtime",
)

gerbil_project_dev(
    name = "dev_compile",
    args = ["compile"],
    build_script = "//:build.ss",
    deps = [":gslph_package"],
    tags = [
        "local",
        "manual",
    ],
)

gerbil_project_dev(
    name = "dev_unit_tests",
    args = ["compile"],
    build_script = "//:build.ss",
    deps = [":gslph_package"],
    tags = [
        "local",
        "manual",
    ],
    tests = ["//:t/unit-tests.ss"],
)

filegroup(
    name = "project_root",
    srcs = [":compile"],
    output_group = "project_root",
)

filegroup(
    name = "compile_log",
    srcs = [":compile"],
    output_group = "log",
)

filegroup(
    name = "compile_receipt",
    srcs = [":compile"],
    output_group = "receipt",
)

gerbil_project_receipt_v1_test(
    name = "compile_receipt_v1_test",
    consumer_inputs = [":dependency_source_contract_projection"],
    consumer_validator = ":validate_compile_receipt_v1.ss",
    receipt = ":compile_receipt",
)

sh_test(
    name = "compile_receipt_contract_mismatch_test",
    srcs = ["validate_compile_receipt_v1_negative_test.sh"],
    args = [
        "$(rlocationpath @local_gerbil//:gxi)",
        "$(rlocationpath :validate_compile_receipt_v1.ss)",
        "$(rlocationpath :compile_receipt)",
        "$(rlocationpath :dependency_source_contract_projection)",
    ],
    data = [
        ":compile_receipt",
        ":dependency_source_contract_projection",
        ":validate_compile_receipt_v1.ss",
        "@local_gerbil//:gxi",
    ],
)

sh_test(
    name = "compile_performance_budget_validator_test",
    size = "small",
    srcs = ["validate_compile_performance_budget_v1_test.sh"],
    args = [
        "$(rlocationpath @local_gerbil//:gxi)",
        "$(rlocationpath :validate_compile_performance_budget_v1.ss)",
        "$(rlocationpath :compile_performance_budget_package_project_root)",
        "$(rlocationpath :gerbil_poo_package_project_root)",
        "$(rlocationpath :gerbil_utils_package_project_root)",
        "$(rlocationpath :compile_performance_budget_accepted.json)",
        "$(rlocationpath :compile_performance_budget_regressed.json)",
    ],
    data = [
        ":compile_performance_budget_package_project_root",
        ":compile_performance_budget_accepted.json",
        ":compile_performance_budget_regressed.json",
        ":gerbil_poo_package_project_root",
        ":gerbil_utils_package_project_root",
        ":validate_compile_performance_budget_v1.ss",
        "@local_gerbil//:gxi",
    ],
)

gerbil_project_projection(
    name = "wheel_smoke_projection_artifact",
    output_name = "wheel_smoke.ss.poo-flow-projection.sexp",
    project = ":compile",
    projection_source = "//:runtime_load_projection_source",
    source = "//packages/python-runtime/src/poo_flow_runtime:wheel_smoke_projection_source",
)

[
    gerbil_project_test(
        name = name,
        size = size,
        srcs = "//:scheme_test_sources",
        project = ":compile",
        source_root_marker = "//:scheme_source_root_marker",
        tags = ["exclusive"],
        tests = [test_root],
    )
    for name, size, test_root in [
        ("unit_tests", "medium", "//:t/unit-tests.ss"),
        (
            "protocol_person_promotion_test",
            "small",
            "//:t/protocol-person-promotion-test.ss",
        ),
        (
            "protocol_person_runtime_abi_test",
            "small",
            "//:t/protocol-person-runtime-abi-test.ss",
        ),
        ("contract_tests", "small", "//:t/contract-tests.ss"),
        ("cli_support_tests", "small", "//:t/cli-support-tests.ss"),
        ("integration_tests", "small", "//:t/integration-tests.ss"),
        ("performance_tests", "large", "//:t/performance-tests.ss"),
        (
            "user_interface_custom_loop_engine_capability_test",
            "large",
            "//:t/user-interface-custom-loop-engine-capability-test.ss",
        ),
    ]
]

test_suite(
    name = "tests",
    tests = [
        ":cli_support_tests",
        ":compile_performance_budget_unit_test",
        ":compile_performance_budget_validator_test",
        ":contract_tests",
        ":integration_tests",
        ":protocol_person_promotion_test",
        ":protocol_person_runtime_abi_test",
        ":unit_tests",
        ":user_interface_custom_loop_engine_capability_test",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":performance_tests",
        ":tests",
    ],
)
