import json, shutil
from pathlib import Path
from poo_flow_runtime import SemanticRuntime, RuntimeGraphProgram, RuntimeGraphRuntime, RuntimeGraphRegistries, linear_plan
from poo_flow_runtime._native.session import NativeRuntimeSession, NativeBundleDescriptor
import poo_flow_runtime
assert shutil.which('gxi') is None
assert '/poo-observe-installed-20261003/' in str(Path(poo_flow_runtime.__file__))
task={'lens':{'generation':1,'clock':'c','start':0,'end':5,'asOf':5,'cut':'cut','members':['a','b'],'horizon':8,'closed':True},'source':{'identity':'source','generation':1,'clock':'c','events':[['a',1,1],['b',2,2]],'parents':[['a','b']]},'root':'a'}
with SemanticRuntime.bundled() as runtime:
 assert not hasattr(runtime,'render_temporal_answer')
 observations=[]
 def predict(supplied):
  assert supplied==task and 'rows' not in supplied
  return '{"status":"complete","rows":[]}'
 result=runtime.predict_temporal_answer(task,predict,observation_sink=observations.append)
 assert result['receipt']['difference']=={'kind':'missing-row','index':0,'expected':['a','b']}
 assert result==observations[0]
 assert runtime.observe_model_answer(task,'{"status":"complete","rows":[["a","b"]]}')['verdict']=='consistent'
 with NativeRuntimeSession(NativeBundleDescriptor(bytes(32),1,b'bundle')) as session:
  program=RuntimeGraphProgram(plan=linear_plan('act'),runtime=RuntimeGraphRuntime.native(session,semantic_context=runtime),registries=RuntimeGraphRegistries(actions={'act':lambda state:{'answer':state['value']+1}}))
  execution=program.invoke_with_trace({'value':41})
  assert execution.state['answer']==42 and execution.validation.kind=='scheme-graph-admission'
 print('WHEEL-OK installed task-first callback, current native difference, observation delivery, real control session, graph and Python IO; no Gerbil executable; offline callback fixture, not a model score')
 print(json.dumps(result,sort_keys=True))
