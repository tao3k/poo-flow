"""Manual continuation: reuse saved terminal response; never repeat provider calls."""
import json, os, time, sys, statistics
from pathlib import Path
from openai import OpenAI
from poo_flow_testing.ascent.live import key_from_file
from poo_flow_testing.model_study.direct.tasks import digest,DIRECT_MODULES
from poo_flow_testing.model_study.direct.preview import producer_hashes,native_bindings
from poo_flow_testing.model_study.direct.live import _request,_provider_response
from poo_flow_testing.model_study.direct.native import score_candidate
root=Path('/private/tmp/poo-plan-audit-20261002');ascent=Path('/private/tmp/ascent-plan-audit-20261002');preview=Path('/private/tmp/poo-direct-understanding-preview-20261003-release');output=Path('/private/tmp/poo-direct-understanding-live-20261003')
encoded=(preview/'plan.json').read_bytes(); plan=json.loads(encoded)
assert digest(encoded)=='910359b8a90c29ea77485f4dcff80fa7cc63ac0af1f8870b501848701ef27506'
assert producer_hashes()==plan['producerHashes'] and native_bindings()==plan['nativeBindings']
assert all(digest((ascent/n).read_bytes())==plan['modules'][n] for n in DIRECT_MODULES)
assert digest((root/'t/model-study/direct-understanding/prediction-score.ss').read_bytes())==plan['scorerSha256']
for c in plan['cases']:
 assert digest((preview/f"{c['id']}.input.ss").read_bytes())==c['inputSha256']
 assert digest((preview/'private'/f"{c['id']}.sexp").read_bytes())==c['expectedSha256']
 assert digest((preview/f"{c['id']}.ss").read_bytes())==c['nativeProgramSha256']
assert json.loads((preview/'paid-batch-claim.json').read_text())['output']==str(output)
records=[json.loads(s) for s in (output/'calls.jsonl').read_text().splitlines()]
attempts=[json.loads(s) for s in (output/'attempts.jsonl').read_text().splitlines()]
assert len(records)==14 and len(attempts)==15
assert [x['index'] for x in records]==list(range(14)) and [x['index'] for x in attempts]==list(range(15))
assert len(list(output.glob('*.response.json')))==15
with (output/'manual-continuation-claim.json').open('x') as f:
 json.dump({'planSha256':digest(encoded),'scriptSha256':digest(Path(__file__).read_bytes()),'originalProviderAttempts':15,'newProviderIndices':list(range(15,24)),'providerRetries':0,'reason':'Saved terminal response 14 recovered locally after native watchdog stop; native probe passed unchanged 5-second gate; only never-attempted frozen requests continue.'},f);f.flush();os.fsync(f.fileno())
print('RECOVER SAVED RESPONSE 15: no provider call',flush=True)
item=plan['order'][14]; saved=json.loads((output/'14.response.json').read_text()); events=[json.loads(s) for s in (output/'14.response.events.jsonl').read_text().splitlines()]
raw=''.join(e.get('delta','') for e in events if e['type']=='response.output_text.delta')
started=time.perf_counter(); observation=score_candidate(root,preview/'private'/f"{item['case']}.sexp",raw,output/'14.guard-recovery',preview/f"{item['case']}.ss")
def bind(observation,item):
 observation.update(taskSha256=next(c['inputSha256'] for c in plan['cases'] if c['id']==item['case']),sourceHeads={'poo':plan['pooHead'],'ascent':plan['ascentHead']})
bind(observation,item)
record=dict(attempts[14],raw=raw,observation=observation,responseId=saved['id'],responseStatus=saved['status'],usage=saved.get('usage'),reasoningEvents=sum(e['type'].startswith('response.reasoning') for e in events),providerSeconds=None,nativeSeconds=time.perf_counter()-started,providerAndGuardSeconds=None,nativeRecovery=True)
def save(record):
 with (output/'calls.jsonl').open('a') as f:f.write(json.dumps(record)+'\n');f.flush();os.fsync(f.fileno())
 records.append(record)
save(record)
initial={r['family']:r for r in records if r['arm']=='initial-high'}
client=OpenAI(api_key=key_from_file(Path('/Users/guangtao/ghq/github.com/tao3k/meta-relational-reasoning/.env')),base_url='https://api.deepseek.com',max_retries=0,timeout=90)
for index in range(15,24):
 item=plan['order'][index]; request=_request(plan,preview,item,initial);path=output/f'{index:02d}.request.json'; assert not path.exists()
 path.write_text(json.dumps(request,ensure_ascii=False,indent=2)+'\n')
 attempt=dict(item,index=index,planSha256=digest(encoded),requestSha256=digest(path.read_bytes()))
 with (output/'attempts.jsonl').open('a') as f:f.write(json.dumps(attempt)+'\n');f.flush();os.fsync(f.fileno())
 print(f'MODEL START {index+1}/24 {item["case"]} {item["arm"]}',flush=True)
 raw,terminal,reasoning,seconds=_provider_response(client,request,output/f'{index:02d}.response.json')
 start=time.perf_counter(); observation=score_candidate(root,preview/'private'/f"{item['case']}.sexp",raw,output/f'{index:02d}.guard',preview/f"{item['case']}.ss"); native=time.perf_counter()-start;bind(observation,item)
 record=dict(attempt,raw=raw,observation=observation,responseId=terminal.id,responseStatus=terminal.status,usage=terminal.usage.model_dump() if terminal.usage else None,reasoningEvents=reasoning,providerSeconds=seconds,nativeSeconds=native,providerAndGuardSeconds=seconds+native)
 save(record)
 if item['arm']=='initial-high':initial[item['family']]=record
 print('DONE',observation['correct'],terminal.status,flush=True)
assert len(records)==24 and len({r['responseId'] for r in records})==24
report={'planSha256':digest(encoded),'completedCalls':24,'retries':0,'nativeRecoveryCount':1,'scope':'Six-family pilot; one saved response locally rescored after native watchdog failure; no duplicate provider call.'}
for arm in ('initial-none','initial-high','transfer-fresh','transfer-feedback'):
 rows=[r for r in records if r['arm']==arm]; inputs=sum(r['usage']['input_tokens'] for r in rows);outputs=sum(r['usage']['output_tokens'] for r in rows)
 report[arm]={'attempts':len(rows),'completed':sum(r['responseStatus']=='completed' for r in rows),'readable':sum(r['observation']['readable'] for r in rows),'correct':sum(r['observation']['correct'] and r['responseStatus']=='completed' for r in rows),'inputTokens':inputs,'outputTokens':outputs,'reasoningTokens':sum(r['usage']['output_tokens_details']['reasoning_tokens'] for r in rows),'estimatedUsdAtPeakCeiling':(inputs*.3+outputs*1.2)/1e6,'providerMedianSeconds':statistics.median(r['providerSeconds'] for r in rows if r['providerSeconds'] is not None),'providerAndGuardMedianSeconds':statistics.median(r['providerAndGuardSeconds'] for r in rows if r['providerAndGuardSeconds'] is not None),'timingSampleCount':sum(r['providerSeconds'] is not None for r in rows)}
(output/'report.json').write_text(json.dumps(report,indent=2)+'\n'); print('STUDY-OK 24 unique calls, zero provider retries',flush=True)
