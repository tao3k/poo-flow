import json, statistics
from pathlib import Path
from poo_flow_testing.model_study.prediction_transport import prediction_from_output
from poo_flow_testing.model_study.direct.native import score_candidate
from poo_flow_testing.model_study.direct.tasks import digest
root=Path('/private/tmp/poo-plan-audit-20261002'); preview=Path('/private/tmp/poo-direct-understanding-preview-20261003-release'); live=Path('/private/tmp/poo-direct-understanding-live-20261003'); output=Path('/private/tmp/poo-direct-understanding-transport-replay-20261003')
output.mkdir(exist_ok=False)
rows=[]
for raw in (live/'calls.jsonl').read_text().splitlines():
 r=json.loads(raw); candidate=prediction_from_output(r['raw'])
 print('REPLAY START',r['index'],r['arm'],flush=True)
 observation=score_candidate(root,preview/'private'/f"{r['case']}.sexp",candidate,output/f"{r['index']:02d}.guard",preview/f"{r['case']}.ss") if candidate is not None else {'correct':False,'readable':False,'transportAmbiguousOrAbsent':True}
 row={'index':r['index'],'case':r['case'],'arm':r['arm'],'responseStatus':r['responseStatus'],'rawSha256':digest(r['raw'].encode()),'extracted':candidate,'observation':observation}
 rows.append(row)
 with (output/'replay.jsonl').open('a') as f:f.write(json.dumps(row)+'\n')
 print('REPLAY DONE',observation['correct'],flush=True)
report={'scope':'post hoc inert prediction extraction, no new provider calls; original scores immutable','paidCalls':0,'extractorSha256':digest((root/'packages/python-testing/src/poo_flow_testing/model_study/prediction_transport.py').read_bytes())}
for arm in ('initial-none','initial-high','transfer-fresh','transfer-feedback'):
 values=[r for r in rows if r['arm']==arm];report[arm]={'attempts':len(values),'extractable':sum(x['extracted'] is not None for x in values),'correct':sum(x['observation']['correct'] and x['responseStatus']=='completed' for x in values),'incomplete':sum(x['responseStatus']!='completed' for x in values)}
(output/'report.json').write_text(json.dumps(report,indent=2)+'\n')
print('REPLAY-OK',json.dumps(report),flush=True)
