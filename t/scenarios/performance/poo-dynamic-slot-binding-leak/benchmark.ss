((benchmarkKind . scenario-e2e)
 (max_total . 100ms)
 (target_total . 5ms)
 (regression_budget . 95ms)
 (expected_over_input_budget . 1ms)
 (sampleCount . 20)
 (targetRationale . "Diagnostic only: every unsafe POO leak probe must be isolated in a bounded child process.")
 (maxRssMb . 256)
 (memoryMetric . resident-set-size)
 (memoryUnit . "MB")
 (iterations . 1)
 (unit . "ms")
 (sourcePath . "t/scenarios/performance/poo-dynamic-slot-binding-leak/benchmark.ss")
 (rule . GERBIL-SCHEME-AGENT-R050)
 (feature . poo-dynamic-slot-binding-leak)
 (optimizationFocus . "classify POO dynamic slot value memory leak boundaries")
 (inputShape . "bounded child-process matrix over .o/.ref slot binding shapes")
 (expectedOutcome . "the poo-dynamic-slot-binding-leak scenario preserves its declared semantic result under the ASP P95 gate")
 (expectedRepair . "identify whether dynamic .o slot values, same-name bindings, or .ref cache lookup owns the leak")
 (policySource . "t/scenarios/performance/poo-dynamic-slot-binding-leak/policy.ss")
 (unsafeShape . "(.o ... (slot slot) ...)")
 (safeRewrite . "rename lexical value bindings before passing them to .o slot forms")
 (ownershipRule . "downstream scenario evidence first; no upstream patch before downstream style repair is ruled out")
 (pooFormEvidence . (.o .def))
 (pooUsageCallEvidence . (.ref .o .def))
 (measurementPhases spawn limit classify assert-time-gate observe-runtime-memory)
 (tags poo performance leak diagnostic quarantine))
