((benchmarkKind . scenario-e2e)
 (max_total . 100ms)
 (target_total . 25ms)
 (regression_budget . 75ms)
 (expected_over_input_budget . 5ms)
 (sampleCount . 20)
 (targetRationale . "Pinned to the std/misc/list hash-backed stable duplicate projection over 20,000 values.")
 (maxRssMb . 256)
 (memoryMetric . resident-set-size)
 (memoryUnit . "MB")
 (iterations . 3)
 (unit . "ms")
 (sourcePath . "t/scenarios/performance/functional-stable-duplicates/benchmark.ss")
 (rule . GERBIL-SCHEME-AGENT-R031)
 (feature . functional-stable-duplicates)
 (optimizationFocus . "compose std/misc/list duplicates and delete-duplicates/hash instead of fold plus repeated member scans")
 (inputShape . "10,000 unique integers repeated once for 20,000 total inputs")
 (expectedOutcome . "all 10,000 duplicated values are projected once in first-seen order under the ASP P95 gate")
 (expectedRepair . "retain the shared functional owner and upstream hash algorithms; do not restore quadratic caller-local scans")
 (measurementPhases collect-before policy-before collect-after policy-after assert-time-gate observe-runtime-memory)
 (tags poo functional stdlib hash performance big-o))
