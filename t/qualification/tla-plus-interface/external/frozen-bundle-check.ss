(import (only-in :clan/poo/object .o .ref)
        (only-in :std/encoding/json read-json JSONReadOptions current-json-read-options)
        (only-in :std/misc/ports read-all-as-string)
        (only-in :std/list/list filter)
        :poo-flow/modules/tla-plus/interface)
(export main)
(def (string-suffix? suffix text)
  (and (>= (string-length text) (string-length suffix))
       (equal? suffix (substring text (- (string-length text) (string-length suffix)) (string-length text)))))
(def (check-directory tools directory names: (selected #f))
  (let* ((names (or selected (filter (lambda (name) (or (string-suffix? ".tla" name) (string-suffix? ".cfg" name))) (directory-files directory))))
         (configs (filter (lambda (name) (string-suffix? ".cfg" name)) names))
         (_ (unless (= (length configs) 1) (error "bundle requires one root config" directory)))
         (root (substring (car configs) 0 (- (string-length (car configs)) 4)))
         (files (map (lambda (name) (poo-flow-tla-source-file name
                       (call-with-input-file (path-expand name directory) read-all-as-string))) names))
         (bundle (poo-flow-tla-bundle root files tools)))
    (displayln "BUNDLE-CONSTRUCTED " (.ref bundle 'semantic-digest)) (force-output)
    (let (checked (poo-flow-tla-check-bundle! bundle))
      (poo-flow-tla-checked-bundle-replay checked bundle)
      (unless (equal? (.ref checked 'bundle-digest) (.ref bundle 'semantic-digest)) (error "receipt identity differs"))
      (let (rejected? #f)
        (with-catch (lambda (_) (set! rejected? #t))
          (lambda () (poo-flow-tla-checked-bundle-replay (.o (:: @ checked) output-digest: "forged") bundle)))
        (unless rejected? (error "forgery was accepted"))
        (displayln "BUNDLE-FORGERY-REJECTED") (force-output))
      (displayln "BUNDLE-CHECK-OK " (.ref checked 'identity)) (force-output))))

(def (main pins-path corpus: (corpus #f) count: (expected #f))
  (let* ((pins (parameterize ((current-json-read-options (JSONReadOptions object-as-hash: #t)))
                (call-with-input-file pins-path read-json)))
         (tools (poo-flow-tla-toolchain (hash-get pins "java") (hash-get pins "jar")
                   (map (lambda (row) (apply poo-flow-tla-tool-artifact row)) (hash-get pins "artifacts")))))
    (if corpus
      (let (n (string->number expected))
        (unless (and (exact-integer? n) (> n 0) (= n (length (directory-files corpus)))) (error "corpus count differs"))
        (let loop ((i 1))
          (when (<= i n)
            (displayln "FROZEN-CORPUS " i "/" n) (force-output)
            (check-directory tools (path-expand (number->string i) corpus))
            (loop (+ i 1))))
        (displayln "FROZEN-CORPUS-OK " n) (force-output))
      (check-directory tools "packages/proofs/tla/temporal-causality" names: '("TemporalFamilyCase.tla" "TemporalFamilyCase.cfg" "TemporalFamilyExplorer.tla" "TemporalHypothesisFamily.tla" "TemporalFamilySemantics.tla" "TemporalOrder.tla")))))
