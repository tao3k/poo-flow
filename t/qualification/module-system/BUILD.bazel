load("@gerbil_bazel//gerbil:defs.bzl", "gerbil_project_test")
load("@rules_python//python:py_test.bzl", "py_test")
load(":ownership.bzl", "OWNER_MAP_ROWS")

package(default_visibility = ["//visibility:public"])

[
    filegroup(
        name = row["target_name"],
        srcs = ["//:" + row["source_path"]],
    )
    for row in OWNER_MAP_ROWS
]

py_test(
    name = "owner_map_contract_test",
    srcs = [
        "owner_map_test.py",
        "validate_owner_map.py",
    ],
    data = [
        ":owner-contract-test.ss",
        ":ownership.bzl",
        "//:scheme_build_sources",
        "//:t/module-system-observability-test.ss",
        "//:t/profile-composition-test.ss",
    ],
    imports = ["."],
    main = "owner_map_test.py",
    python_version = "3.12",
)

gerbil_project_test(
    name = "owner_contract_test",
    size = "small",
    srcs = "//:scheme_build_sources",
    project = "//gerbil:compile",
    source_root_marker = "//:scheme_source_root_marker",
    tags = ["exclusive"],
    tests = [
        ":owner-contract-test.ss",
        "//:t/module-system-observability-test.ss",
        "//:t/profile-composition-test.ss",
    ],
)

gerbil_project_test(
    name = "package_spec_root_mode_ab_test",
    size = "medium",
    srcs = [
        "//:t/package-spec-root-mode-ab-scenario-test.ss",
        "//:t/scenarios/building/package-spec-root-mode-ab/closure-build.ss",
        "//:t/scenarios/building/package-spec-root-mode-ab/contract.ss",
        "//:t/scenarios/building/package-spec-root-mode-ab/modules-build.ss",
    ],
    project = "//gerbil:compile",
    source_root_marker = "//:scheme_source_root_marker",
    tags = ["exclusive"],
    tests = ["//:t/package-spec-root-mode-ab-scenario-test.ss"],
)

test_suite(
    name = "owner_map_tests",
    tests = [
        ":package_spec_root_mode_ab_test",
        ":owner_contract_test",
        ":owner_map_contract_test",
    ],
)
