;;; -*- Gerbil -*-
;;; SPDX-FileCopyrightText: 2026 tao3k team and Contributors
;;; SPDX-License-Identifier: Apache-2.0 AND LGPL-2.1-or-later
;;; Replay admission for exactly the two native finite semantic profiles.
;;; This is model-relative evidence, never source authority or an arbitrary
;;; theorem checker. Unknown and unfinished evaluations cannot be published.
(import (only-in :clan/poo/object .ref) (only-in :std/list/list every find)
        (only-in :std/crypto/digest sha256) (only-in :std/encoding/hex hex-encode)
        (only-in :poo-flow/modules/temporal-causality/types poo-flow-temporal-model? poo-flow-temporal-query?)
        (only-in :poo-flow/modules/temporal-causality/funs poo-flow-temporal-model-classify poo-flow-temporal-model-replay)
        (only-in :poo-flow/modules/temporal-causality/behavior/types
                 poo-flow-temporal-behavior-model? poo-flow-temporal-behavior-query?)
        (only-in :poo-flow/modules/temporal-causality/behavior/funs poo-flow-temporal-behavior-explore poo-flow-temporal-behavior-model-replay)
        "evaluation-types.ss" "evaluation-objects.ss")
(export poo-flow-temporal-evaluate poo-flow-temporal-evaluation-replay poo-flow-temporal-evaluation-admit)
(def (digest v) (string-append "sha256:" (hex-encode (sha256 (string->utf8 (object->string v))))))
(def +context+ '(subject scope cut projection policy generation))
(def (poo-flow-temporal-evaluate model query subject scope cut projection policy generation)
  (let* ((hypothesis? (and (poo-flow-temporal-model? model) (poo-flow-temporal-query? query)))
         (behavior? (and (poo-flow-temporal-behavior-model? model) (poo-flow-temporal-behavior-query? query)))
         (profile (cond (hypothesis? 'finite-hypothesis-v2) (behavior? 'finite-behavior-v1)
                        (else (error "unsupported temporal evaluator model/query profile"))))
         (statement
          (if hypothesis?
            (let (target (find (lambda (h) (equal? (.ref h 'identity) (.ref query 'hypothesis-identity))) (.ref model 'hypotheses)))
              (unless target (error "evaluation target is absent from model"))
              (list profile (.ref target 'identity) (.ref target 'cause-observation-id) (.ref target 'effect-observation-id)
                    (list-sort (lambda (a b) (string<? (car a) (car b)))
                      (map (lambda (c) (map (lambda (s) (.ref c s))
                                      '(identity relation left-observation-id right-observation-id))) (.ref target 'constraints)))))
            (let (p (.ref query 'property))
              (list profile (.ref p 'identity) (.ref p 'question) (.ref p 'deadline)
                    (list-sort (lambda (a b) (string<? (car a) (car b)))
                      (map (lambda (c) (list (.ref c 'identity) (.ref c 'variable) (.ref c 'value))) (.ref p 'conditions)))))))
         (query-row (if hypothesis? (list statement (.ref query 'identity) (.ref query 'exploration-limit))
                       (list statement (.ref query 'identity) (.ref query 'world-limit) (.ref query 'node-limit))))
         (result (if hypothesis? (poo-flow-temporal-model-classify model query)
                                 (poo-flow-temporal-behavior-explore model query)))
         (classification (.ref result 'classification))
         (exhausted (.ref result 'exhausted?))
         (admitted (and exhausted (not (eq? classification 'unknown))))
         (context (list subject scope cut projection policy generation))
         (id (digest (list 'poo-flow.temporal.evaluation.v1 profile (.ref model 'semantic-digest)
                           (digest query-row) context classification exhausted admitted))))
    (poo-flow-temporal-evaluation-value id profile model query (.ref model 'semantic-digest)
      (digest query-row) (digest statement) subject scope cut projection policy generation classification exhausted admitted)))
(def (poo-flow-temporal-evaluation-replay evaluation)
  (unless (poo-flow-temporal-evaluation? evaluation) (error "invalid temporal evaluation"))
  (let (canonical (apply poo-flow-temporal-evaluate
                        (append (list (.ref evaluation 'model) (.ref evaluation 'query))
                                (map (lambda (s) (.ref evaluation s)) +context+))))
    (unless (every (lambda (s) (equal? (.ref canonical s) (.ref evaluation s)))
                   (append '(identity profile model-digest query-digest statement-digest classification exhausted? admitted? action-authorized?) +context+))
      (error "temporal evaluation differs from native replay")) canonical))
(def (poo-flow-temporal-evaluation-admit evaluation revision model journal prior: (prior #f))
  (let (evaluation (poo-flow-temporal-evaluation-replay evaluation))
    (case (.ref evaluation 'profile)
      ((finite-hypothesis-v2) (poo-flow-temporal-model-replay model))
      ((finite-behavior-v1) (poo-flow-temporal-behavior-model-replay model)))
    (unless (and (.ref evaluation 'admitted?)
                 (equal? (.ref evaluation 'model-digest) (.ref model 'semantic-digest))
                 (equal? (.ref evaluation 'identity) (.ref revision 'proof-identity))
                 (every (lambda (pair) (equal? (.ref evaluation (car pair)) (.ref revision (cdr pair))))
                        '((subject . subject-identity) (scope . scope-identity) (cut . cut-digest)
                          (projection . projection-digest) (policy . policy-identity) (generation . generation-identity))))
      (error "conclusion has no admitted scoped native evaluation"))
    (unless (eq? (.ref revision 'operation) 'assert)
      (let* ((previous-evaluation (poo-flow-temporal-evaluation-replay prior))
             (previous (find (lambda (r) (equal? (.ref r 'identity) (.ref revision 'predecessor-identity)))
                             (.ref journal 'revisions))))
        (unless previous (error "evaluation predecessor is absent from journal"))
        (unless (every (lambda (pair) (equal? (.ref previous-evaluation (car pair)) (.ref previous (cdr pair))))
                       '((subject . subject-identity) (scope . scope-identity) (cut . cut-digest)
                         (projection . projection-digest) (policy . policy-identity) (generation . generation-identity)))
          (error "prior evaluation scope differs from journal predecessor"))
        (unless (and (.ref previous-evaluation 'admitted?)
                     (equal? (.ref previous-evaluation 'identity) (.ref previous 'proof-identity))
                     (equal? (.ref previous-evaluation 'statement-digest) (.ref evaluation 'statement-digest))
                     (if (eq? (.ref revision 'operation) 'retract)
                       (and (memq (.ref previous-evaluation 'classification) '(necessary possible))
                            (eq? (.ref evaluation 'classification) 'refuted)) #t)
                     (equal? (.ref previous 'result-identity) (symbol->string (.ref previous-evaluation 'classification))))
          (error "retraction lacks a replayed prior claim and its scoped refutation"))))
    (unless (eq? (.ref revision 'operation) 'retract)
      (unless (equal? (.ref revision 'result-identity) (symbol->string (.ref evaluation 'classification)))
        (error "conclusion result differs from evaluated classification"))) evaluation))
