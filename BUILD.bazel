package(default_visibility = ["//visibility:public"])

exports_files([
    "gerbil-dependencies.MODULE.bazel",
    "t/feature-system-bundle-v1-foreign-arena-fixture.ss",
    "t/module-system-observability-test.ss",
    "t/profile-composition-test.ss",
])

filegroup(
    name = "runtime_v0_schema",
    srcs = ["src/contract/runtime-v0-abi-schema.ss"],
)

filegroup(
    name = "scheme_runtime_sources",
    srcs = glob([
        "gerbil.pkg",
        "src/**/*.inc",
        "src/**/*.scm",
        "src/**/*.ss",
        "src/**/*.ssi",
    ]),
)

filegroup(
    name = "scheme_source_root_marker",
    srcs = ["gerbil.pkg"],
)

filegroup(
    name = "scheme_test_support_sources",
    srcs = [
        "t/domain-case-test-support.ss",
        "t/fixtures/bundle-v1-domain-case-projection.ss",
        "t/fixtures/object-load-valid/objects.ss",
        "t/fixtures/object-load-valid/parts/object1.ss",
        "t/module-system-poo-performance-test-support/composition-gates.ss",
        "t/module-system-poo-performance-test-support/composition-large-library.ss",
        "t/module-system-poo-performance-test-support/composition-scenarios.ss",
        "t/scenarios/performance/composition-macro-expansion/benchmark.ss",
        "t/user-interface-fixtures.ss",
    ] + glob(["t/support/**/*.ss"]),
)

filegroup(
    name = "scheme_build_sources",
    srcs = [
        "build.ss",
        ":scheme_runtime_sources",
        ":scheme_test_support_sources",
    ] + glob([
        "bindings/nono-c/**/*.h",
        "user-interface/**/*.ss",
    ]),
)

filegroup(
    name = "runtime_load_projection_source",
    srcs = ["src/modules/funflow/runtime-load-projection.ss"],
)

filegroup(
    name = "json_schema_native_contract_test_support",
    srcs = [
        "schemas/json/github-workflow.json",
        "t/funflow-github-ci-json-schema-contract-test.ss",
        "t/json-schema-contract-bridge-test.ss",
        "t/json-schema-native-contract-test.ss",
    ],
)

filegroup(
    name = "type_contract_performance_test_support",
    srcs = [
        "t/support/performance.ss",
        "t/support/type-contract-performance.ss",
    ],
)
