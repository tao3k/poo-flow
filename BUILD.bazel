package(default_visibility = ["//visibility:public"])

exports_files([
    "gerbil-dependencies.MODULE.bazel",
    "t/feature-system-bundle-v1-foreign-arena-fixture.ss",
])

filegroup(
    name = "runtime_v0_schema",
    srcs = ["src/contract/runtime-v0-abi-schema.ss"],
)

filegroup(
    name = "scheme_runtime_sources",
    srcs = glob([
        "gerbil.pkg",
        "src/**/*.inc",
        "src/**/*.scm",
        "src/**/*.ss",
        "src/**/*.ssi",
    ]),
)

filegroup(
    name = "scheme_source_root_marker",
    srcs = ["gerbil.pkg"],
)

filegroup(
    name = "scheme_build_sources",
    srcs = [
        "build.ss",
        ":scheme_runtime_sources",
    ] + glob([
        "bindings/nono-c/**/*.h",
        "t/**/*.ss",
        "user-interface/**/*.ss",
    ]),
)

filegroup(
    name = "runtime_load_projection_source",
    srcs = ["src/modules/funflow/runtime-load-projection.ss"],
)

filegroup(
    name = "json_schema_native_contract_test_support",
    srcs = [
        "schemas/json/github-workflow.json",
        "t/funflow-github-ci-json-schema-contract-test.ss",
        "t/json-schema-contract-bridge-test.ss",
        "t/json-schema-native-contract-test.ss",
    ],
)

filegroup(
    name = "type_contract_performance_test_support",
    srcs = [
        "t/support/performance.ss",
        "t/support/type-contract-performance.ss",
    ],
)
